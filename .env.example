# Copiar como .env (no se sube al repo) y cambiar lo que haga falta.
# Sin .env, docker compose up no arranca: el back lo lee entero (env_file).

# El modo, que se elige antes del primer up:
#   demo   con la semilla de la demo: cuatro locales con su personal, sus cartas y 30 días de historial.
#          Es con el que se prueba. Corre una sola vez, sobre la base vacía.
#   vacío  (SPRING_PROFILES_ACTIVE=) sin semilla, para darle la app a un cliente: el primer local se crea
#          con las variables CHITGO_* de abajo.
# No se cambia de modo sobre la misma base: para pasar de uno al otro, docker compose down -v (borra la base).
# Con demo sobre una base que ya tiene locales, el back no arranca y lo dice.
SPRING_PROFILES_ACTIVE=demo

# El primer local y su Gerente/Dueño, solo para el modo sin semilla. Con demo quedan vacías.
# Van las cinco o ninguna: con algunas sí y otras no, el back no arranca (también con demo).
# Se crean al arrancar, solo si la base no tiene ningún local: reiniciar no crea otro.
# La contraseña es provisoria, de 8 a 64 caracteres: al primer ingreso el sistema obliga a cambiarla,
# y desde ahí la de acá ya no sirve y se puede borrar.
CHITGO_LOCAL_NOMBRE=
CHITGO_LOCAL_DIRECCION=
CHITGO_GERENTE_NOMBRE=
CHITGO_GERENTE_EMAIL=
CHITGO_GERENTE_CONTRASENA=

# La URL del front, para armar la del login del personal (<URL_FRONT>/staff/<token>) que muestran el primer
# local y el alta de otro local. Si se cambia FRONT_PUERTO, cambiarla también (http://localhost:8088).
URL_FRONT=http://localhost

# La base. Las usa MySQL para crear la base y el usuario la primera vez, y el back para conectarse.
# Si se cambian con la base ya creada, MySQL no las vuelve a leer: hay que borrarla con docker compose down -v.
MYSQL_ROOT_PASSWORD=root
DB_NAME=chitgo
DB_USER=chitgo
DB_PASSWORD=chitgo

# Clave para firmar el JWT de la sesión: 32 bytes o más, en Base64.
# CAMBIARLA SIEMPRE: esta está publicada en el repo, y con ella cualquiera puede armar una sesión válida.
# Para generar una: openssl rand -base64 32
# Si queda vacía, el back arranca con una clave al azar y las sesiones se pierden al reiniciarlo.
JWT_CLAVE=q0ZqEhfvXC8B1e3mRk0yS9Xb3o4m3G6w5dYc7p2Lh1U=

# Secure en la cookie de sesión y en la de CSRF. El back la prende si no se dice nada (solo el perfil dev
# la apaga), así que va en false para entrar por http, también desde un celular con la IP de la compu:
# con true el navegador no guarda la cookie y no se puede iniciar sesión.
# Ponerla en true solo si se entra por https.
COOKIE_SEGURA=false

# Puerto de la compu donde queda el front (http://localhost). Cambiarlo si el 80 está ocupado,
# por ejemplo FRONT_PUERTO=8088 y entrar a http://localhost:8088 (y URL_FRONT igual).
FRONT_PUERTO=80

# Web Push. Las claves VAPID son Base64 URL-safe; la privada nunca se comparte con el front.
PUSH_HABILITADO=false
PUSH_CLAVE_PUBLICA=
PUSH_CLAVE_PRIVADA=
PUSH_CONTACTO=mailto:admin@example.com
PUSH_HOSTS_PERMITIDOS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
